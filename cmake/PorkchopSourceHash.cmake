# Hash of the code and data the porkchop plots depend on, written to a header the porkchop cache
# fingerprint includes: any change to these files makes old cached plots be computed again.
# Run at every build (new files are found without reconfiguring); the header is rewritten only when
# the hash changes, so nothing recompiles otherwise.
# Inputs: SOURCE_DIR, OUT.
set(dirs src/math src/celestial src/trajectory src/variable_isp data/bodies)
set(files)
foreach(dir IN LISTS dirs)
    file(GLOB_RECURSE found "${SOURCE_DIR}/${dir}/*")
    list(APPEND files ${found})
endforeach()
list(SORT files)
set(all "")
foreach(f IN LISTS files)
    file(SHA256 "${f}" h)
    file(RELATIVE_PATH rel "${SOURCE_DIR}" "${f}")
    string(APPEND all "${rel}:${h}\n")
endforeach()
string(SHA256 hash "${all}")
string(SUBSTRING "${hash}" 0 16 hash)
set(text "// Generated by cmake/PorkchopSourceHash.cmake. Do not edit.\n#pragma once\ninline constexpr const char* kPorkchopSourceHash = \"${hash}\";\n")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
