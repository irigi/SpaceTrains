# Godot 4+ specific ignores
.godot/
*.uid

# Godot-specific ignores
*.import
export.cfg
# export_presets.cfg is committed (godot/export_presets.cfg: release presets, no secrets)

# Imported translations (for po/csv)
*.translation

# Mono-specific ignores
.mono/
/godot/data_*/
mono_crash.*.json

# OS-specific
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Local build outputs
build/

# Python environments and bytecode
.venv/
.venv*/
__pycache__/
*.pyc
build-*/

# LaTeX build files of the VariableISP articles
VariableISP/*.aux
VariableISP/*.bbl
VariableISP/*.blg
VariableISP/*.log
VariableISP/*.out
VariableISP/*.toc
VariableISP/**/__pycache__/
# Planet textures need their import settings (VRAM compression, mipmaps).
!godot/assets/planets/*.import

# Release packages (tools/package/build_release.sh)
/dist/
